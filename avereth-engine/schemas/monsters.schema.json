{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth/monsters.schema.json",
  "title": "F1 body-plan anchors and scaling (content/monsters.json)",
  "type": "object",
  "required": [
    "anchors",
    "scaling",
    "level_selection",
    "elite",
    "boss"
  ],
  "properties": {
    "encounter_windows": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1, "maximum": 14 } } },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hp",
          "atk",
          "def",
          "mdef",
          "init",
          "attack",
          "damage_type",
          "range",
          "aliases",
          "source_line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "atk": {
            "type": "integer",
            "minimum": 0
          },
          "def": {
            "type": "integer",
            "minimum": 0
          },
          "mdef": {
            "type": "integer",
            "minimum": 0
          },
          "init": {
            "type": "integer",
            "minimum": 0
          },
          "attack": {
            "type": "string"
          },
          "damage_type": {
            "enum": [
              "physical",
              "magical"
            ]
          },
          "range": {
            "enum": [
              "ENGAGED",
              "SHORT",
              "MEDIUM",
              "LONG"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "temperament": {
            "description": "Legacy paths only (V3, V4-A; an anchor without one is aggressive there). The planner path decides from the fight, not from this (4.3.0-c.6.6.24).",
            "enum": [
              "aggressive",
              "cautious",
              "skittish",
              "defensive"
            ]
          },
          "source_line": {
            "type": "string"
          }
        }
      }
    },
    "level_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "context",
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "max": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "elite": {
      "$ref": "#/$defs/mult"
    },
    "boss": {
      "$ref": "#/$defs/mult"
    }
  },
  "$defs": {
    "mult": {
      "type": "object",
      "required": [
        "hp",
        "atk",
        "def",
        "mdef",
        "init"
      ],
      "properties": {
        "hp": {
          "type": "number"
        },
        "atk": {
          "type": "number"
        },
        "def": {
          "type": "number"
        },
        "mdef": {
          "type": "number"
        },
        "init": {
          "type": "integer"
        }
      }
    }
  }
}
