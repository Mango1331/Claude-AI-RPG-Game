{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth/rules.schema.json",
  "title": "Numeric rule constants (content/rules.json)",
  "type": "object",
  "required": [
    "stats",
    "human_baseline",
    "derived",
    "progression",
    "ranks",
    "hit",
    "crit",
    "damage",
    "proficiency",
    "xp",
    "range",
    "checks",
    "currency",
    "combat"
  ],
  "properties": {
    "stats": {
      "type": "array",
      "minItems": 6,
      "items": {
        "enum": [
          "STR",
          "VIT",
          "AGI",
          "INT",
          "PER",
          "WIL"
        ]
      }
    },
    "hit": {
      "type": "object",
      "required": [
        "character_base",
        "per_factor",
        "clamp_min",
        "clamp_max",
        "partial_cover_pp"
      ]
    },
    "crit": {
      "type": "object",
      "required": [
        "character_base",
        "per_divisor",
        "multiplier",
        "ambush_bonus_pp"
      ]
    },
    "damage": {
      "type": "object",
      "required": [
        "defense_floor_share",
        "variance_min",
        "variance_max"
      ]
    },
    "proficiency": {
      "type": "object",
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "cost",
              "hit_pp",
              "power"
            ]
          }
        }
      }
    },
    "ranks": {
      "type": "object",
      "required": [
        "bands",
        "order"
      ]
    }
  }
}
