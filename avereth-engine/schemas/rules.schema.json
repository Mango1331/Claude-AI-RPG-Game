{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth/rules.schema.json",
  "title": "Numeric rule constants (content/rules.json)",
  "type": "object",
  "required": [
    "stats",
    "human_baseline",
    "derived",
    "progression",
    "ranks",
    "cover",
    "crit",
    "damage",
    "proficiency",
    "xp",
    "range",
    "checks",
    "currency",
    "combat"
  ],
  "properties": {
    "stats": {
      "type": "array",
      "minItems": 6,
      "items": {
        "enum": [
          "STR",
          "VIT",
          "AGI",
          "INT",
          "PER",
          "WIL"
        ]
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "partial_damage_reduction_pct"
      ],
      "properties": {
        "partial_damage_reduction_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "crit": {
      "type": "object",
      "required": [
        "multiplier"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "multiplier": {
          "type": "number"
        },
        "only": {
          "enum": [
            "true_ambush_opening_action"
          ]
        }
      }
    },
    "damage": {
      "type": "object",
      "required": [
        "defense_floor_share",
        "variance_min",
        "variance_max"
      ]
    },
    "proficiency": {
      "type": "object",
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "cost",
              "power"
            ]
          }
        }
      }
    },
    "ranks": {
      "type": "object",
      "required": [
        "bands",
        "order"
      ]
    },
    "guild": {
      "type": "object",
      "required": [
        "branch_kinds"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "branch_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "city",
              "capital",
              "seat"
            ]
          }
        },
        "registration_fee_cp": { "type": "integer", "minimum": 0 },
        "registration_fee_src": { "type": "string" },
        "ranks": { "type": "array", "items": { "type": "string" } },
        "rank_levels": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
        "rank_power": { "type": "object", "additionalProperties": { "type": "string" } },
        "promotion_contracts": { "type": "integer", "minimum": 1 },
        "supported_ranks": { "type": "object" },
        "board": {
          "type": "object",
          "properties": {
            "_status": { "type": "string" },
            "size": { "type": "integer", "minimum": 1 },
            "taken_by_others_pct_per_day": { "type": "integer", "minimum": 0, "maximum": 100 },
            "payout_guide_cp": { "type": "object" }
          }
        }
      }
    },
    "time": {
      "type": "object",
      "required": ["default_cap_min", "travel_cap_min", "until"],
      "properties": {
        "src": { "type": "string" },
        "default_cap_min": { "type": "integer", "minimum": 1 },
        "unknown_place_cap_min": { "type": "integer", "minimum": 1 },
        "travel_cap_min": { "type": "integer", "minimum": 1 },
        "minutes_factor": { "type": "number", "minimum": 1 },
        "done_min": { "type": "integer", "minimum": 1 },
        "combat_cap_min": { "type": "integer", "minimum": 1 },
        "until": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1439 } }
      }
    }
  }
}
