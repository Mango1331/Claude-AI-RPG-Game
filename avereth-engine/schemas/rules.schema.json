{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth/rules.schema.json",
  "title": "Numeric rule constants (content/rules.json)",
  "type": "object",
  "required": [
    "stats",
    "human_baseline",
    "derived",
    "progression",
    "ranks",
    "cover",
    "crit",
    "damage",
    "proficiency",
    "xp",
    "range",
    "checks",
    "currency",
    "combat"
  ],
  "properties": {
    "stats": {
      "type": "array",
      "minItems": 6,
      "items": {
        "enum": [
          "STR",
          "VIT",
          "AGI",
          "INT",
          "PER",
          "WIL"
        ]
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "partial_damage_reduction_pct"
      ],
      "properties": {
        "partial_damage_reduction_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "crit": {
      "type": "object",
      "required": [
        "multiplier"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "multiplier": {
          "type": "number"
        },
        "only": {
          "enum": [
            "true_ambush_opening_action"
          ]
        }
      }
    },
    "damage": {
      "type": "object",
      "required": [
        "defense_floor_share",
        "variance_min",
        "variance_max"
      ]
    },
    "proficiency": {
      "type": "object",
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "cost",
              "power"
            ]
          }
        }
      }
    },
    "ranks": {
      "type": "object",
      "required": [
        "bands",
        "order"
      ]
    }
  }
}
