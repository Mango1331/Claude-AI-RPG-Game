{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth/rules_text.schema.json",
  "title": "Verbatim rule texts (content/rules_text.json)",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "when",
          "engine",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(core|system|content)\\.[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "engine": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}
