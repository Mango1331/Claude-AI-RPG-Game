      role: 'user',
      content: 'CATALOG\n' +
        'HERE: Valedorn Crown › Alderwatch › public roadside verge outside Alderwatch (loc.alderwatch.verge) · day 1, 09:00\n' +
        'PRESENT: nobody besides Alaric\n' +
