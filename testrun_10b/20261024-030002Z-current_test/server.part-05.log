        '- "I step right in among them and then Ember Ring" → {"commands":[{"seq":1,"type":"move","dir":"closer","target":null,"quote":"I step right in among them"},{"seq":2,"type":"use_skill","skill":"mage.ember_ring","target":null,"quote":"Ember Ring"}]}\n' +
        '- "I bolt for the exit" → {"commands":[{"seq":1,"type":"flee","quote":"I bolt for the exit"}]}\n' +
        '- (no fight) "I back away from the sleeping bear and slip back out to the old mill" → {"commands":[{"seq":1,"type":"go","to":"loc.mill","quote":"I back away from the sleeping bear and slip back out to the old mill"}]}\n' +
