        '- (no fight) "I search the nest for coins" → {"commands":[{"seq":1,"type":"activity","kind":"search","what":"coins in the nest","minutes":null,"until":null,"quote":"I search the nest for coins"}]}\n' +
        '- (no fight) "I walk back to the old mill" → {"commands":[{"seq":1,"type":"go","to":"loc.mill","quote":"I walk back to the old mill"}]}\n' +
        '\n' +
